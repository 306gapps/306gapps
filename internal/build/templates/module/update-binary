#!/sbin/sh
# Standard Magisk/KernelSU module installer stub: hands off to the manager's
# own util_functions.sh, which unpacks the module and runs customize.sh.
umask 022
ui_print() { echo "$1"; }

require_manager() {
  ui_print "*********************************************"
  ui_print " 306gapps needs Magisk 20.4+ or KernelSU"
  ui_print "*********************************************"
  exit 1
}

# shellcheck disable=SC2034  # used by ui_print, and exported to the scripts below
OUTFD=$2
# shellcheck disable=SC2034  # read by customize.sh after it is exported
ZIPFILE=$3

mount /data 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] || require_manager
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -lt 20400 ] && require_manager

install_module
exit 0
