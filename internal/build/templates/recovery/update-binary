#!/sbin/sh
# 306gapps recovery entry point. Recovery invokes this as:
#   update-binary <api> <outfd> <zipfile>
OUTFD=$2
ZIPFILE=$3
TMP=/tmp/306gapps

ui_print() {
  echo "ui_print $1" >> /proc/self/fd/"$OUTFD"
  echo "ui_print" >> /proc/self/fd/"$OUTFD"
}

abort() {
  ui_print "! $1"
  exit 1
}

rm -rf "$TMP"
mkdir -p "$TMP" || abort "cannot create $TMP"

# Only the installer payload is unpacked up front; file payloads are streamed
# out of the zip one at a time so we never need room for two copies.
unzip -o "$ZIPFILE" 'installer/*' -d "$TMP" >/dev/null 2>&1 || abort "failed to unpack installer"
chmod -R 0755 "$TMP/installer"

# Recovery environments vary enormously in which applets they provide and how
# those applets behave. We ship a known-good static busybox and put it first on
# PATH so the installer runs against one predictable toolset. If it will not
# run -- wrong architecture, noexec /tmp -- fall back to the recovery's own
# tools rather than refusing to install.
BB="$TMP/installer/busybox"
if [ -f "$BB" ]; then
  chmod 0755 "$BB"
  if "$BB" true 2>/dev/null; then
    mkdir -p "$TMP/bin"
    if "$BB" --install -s "$TMP/bin" 2>/dev/null; then
      export PATH="$TMP/bin:$PATH"
      export BUSYBOX="$BB"
    fi
  fi
fi

export OUTFD ZIPFILE TMP BUSYBOX
. "$TMP/installer/installer.sh"
